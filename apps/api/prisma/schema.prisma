// BeSo – data model. Rationale: docs/REBUILD_PLAN.md §2.3, docs/adr/0002.
// Conventions: UUID v7 ids, snake_case tables/columns, timestamptz in UTC,
// relation tables instead of denormalised columns.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // relationJoins compiles `_count` and filtered relation selects into LATERAL
  // joins instead of whole-table GROUP BY subqueries (see docs/REBUILD_PLAN.md review notes).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  email                 String    @unique
  username              String    @unique
  passwordHash          String    @map("password_hash")
  /// Set once the address was confirmed through a mailed link; the app is closed until then.
  emailVerifiedAt       DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// When the "confirm or the account is removed" mail went out (JobsService); unverified accounts only.
  expiryWarnedAt        DateTime? @map("expiry_warned_at") @db.Timestamptz(3)
  /// A new address waiting for its confirmation link (ADR 0010 amendment); swapped in on confirm.
  pendingEmail          String?   @map("pending_email")
  /// Admins read the reports queue and act on it (ADR 0016); bootstrapped from `ADMIN_EMAILS`.
  role                  UserRole  @default(member)
  /// A suspended member cannot sign in and their content is hidden; the rows stay for the way back.
  suspendedAt           DateTime? @map("suspended_at") @db.Timestamptz(3)
  name                  String
  bio                   String?
  city                  String?
  website               String?
  avatarKey             String?   @map("avatar_key")
  coverKey              String?   @map("cover_key")
  /// A ready-made picture (`@beso/shared/pictures`) in place of an upload; never both.
  avatarPreset          String?   @map("avatar_preset")
  coverPreset           String?   @map("cover_preset")
  /// The Collector ring shown around the avatar (`users/ring.ts`): kept by the badges and the
  /// settings, so the many places that show a member read it without counting anything.
  ring                  String?
  /// Up to three badge keys the member shows under their name, in their order.
  featuredBadges        String[]  @default([]) @map("featured_badges")
  /// Account-level preferences (`userSettingsSchema` in shared); keys are added as features land.
  settings              Json      @default("{}") @db.JsonB
  /// The member's personal invite link, `/join/<code>` (F1): made when first asked for,
  /// replaced on request (the old link stops working).
  inviteCode            String?   @unique @map("invite_code")
  /// Whose invite link the member registered with; null otherwise, or once that member is gone.
  invitedById           String?   @map("invited_by_id") @db.Uuid
  /// When the member's badges were first counted (F2, ADR 0021). A new account starts counted;
  /// the accounts from before F2 start null, and their first count awards silently whatever they
  /// had already reached, so nobody gets a burst of notifications.
  achievementsCheckedAt DateTime? @default(now()) @map("achievements_checked_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  posts             Post[]
  comments          Comment[]
  postLikes         PostLike[]
  following         Follow[]             @relation("FollowFollower")
  followers         Follow[]             @relation("FollowFollowee")
  activities        Activity[]           @relation("ActivityActor")
  targetedBy        Activity[]           @relation("ActivityTargetUser")
  refreshTokens     RefreshToken[]
  invitedBy         User?                @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees          User[]               @relation("UserInvites")
  pushSubscriptions PushSubscription[]
  sentMessages      Message[]            @relation("MessageSender")
  messageReactions  MessageReaction[]
  conversations     ConversationMember[]
  createdGroups     Conversation[]       @relation("ConversationCreator")
  uploads           Upload[]
  commentReactions  CommentReaction[]
  emailTokens       EmailToken[]
  postMentions      PostMention[]
  commentMentions   CommentMention[]
  notifications     Notification[]       @relation("NotificationRecipient")
  notificationsSent Notification[]       @relation("NotificationActor")
  bookmarks         Bookmark[]
  reposts           Repost[]
  blocking          Block[]              @relation("BlockBlocker")
  blockedBy         Block[]              @relation("BlockBlocked")
  muting            Mute[]               @relation("MuteMuter")
  mutedBy           Mute[]               @relation("MuteMuted")
  reports           Report[]             @relation("ReportReporter")
  resolvedReports   Report[]             @relation("ReportResolver")
  adminActions      AdminAction[]
  achievements      UserAchievement[]
  pollVotes         PollVote[]
  /// The one post the member shows first on their profile; null again once that post is deleted.
  pinnedPostId      String?              @unique @map("pinned_post_id") @db.Uuid
  pinnedPost        Post?                @relation("PinnedPost", fields: [pinnedPostId], references: [id], onDelete: SetNull)

  @@index([invitedById])
  @@map("users")
}

enum UserRole {
  member
  admin

  @@map("user_role")
}

enum AdminActionType {
  report_resolved
  report_dismissed
  post_deleted
  comment_deleted
  user_suspended
  user_unsuspended

  @@map("admin_action_type")
}

/// Who did what in the admin queue (ADR 0016): one row per action, kept after the admin or the
/// target is gone (the target by id only).
model AdminAction {
  id        String          @id @default(uuid(7)) @db.Uuid
  adminId   String?         @map("admin_id") @db.Uuid
  action    AdminActionType
  targetId  String?         @map("target_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("admin_actions")
}

/// One member shutting another out, both ways (ADR 0016): nothing of either reaches the other,
/// the follows between them are gone, and neither can start anything with the other.
model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId, createdAt(sort: Desc), blockedId(sort: Desc)])
  @@map("blocks")
}

/// One member quieting another for themselves only: the muted one's posts leave the muter's
/// feeds and their notifications stop; the muted one notices nothing.
model Mute {
  muterId   String   @map("muter_id") @db.Uuid
  mutedId   String   @map("muted_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  muter User @relation("MuteMuter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("MuteMuted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@index([mutedId])
  @@index([muterId, createdAt(sort: Desc), mutedId(sort: Desc)])
  @@map("mutes")
}

enum ReportTargetType {
  post
  comment
  user

  @@map("report_target_type")
}

enum ReportReason {
  spam
  harassment
  hate
  sexual
  violence
  other

  @@map("report_reason")
}

enum ReportStatus {
  open
  resolved
  dismissed

  @@map("report_status")
}

/// A member's complaint about a post, a comment or a member, for the admin queue (B5b). The
/// target is kept by id only: it may well be gone by the time anyone looks at the report.
model Report {
  id           String           @id @default(uuid(7)) @db.Uuid
  reporterId   String           @map("reporter_id") @db.Uuid
  targetType   ReportTargetType @map("target_type")
  targetId     String           @map("target_id") @db.Uuid
  reason       ReportReason
  details      String?
  status       ReportStatus     @default(open)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedById String?          @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?        @map("resolved_at") @db.Timestamptz(3)

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([reporterId, targetType, targetId])
  @@map("reports")
}

enum EmailTokenKind {
  verify_email
  password_reset
  change_email

  @@map("email_token_kind")
}

/// Single-use links we mail. Only the SHA-256 of the token is stored, like refresh tokens.
model EmailToken {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  kind      EmailTokenKind
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("email_tokens")
}

model Post {
  id             String                   @id @default(uuid(7)) @db.Uuid
  authorId       String                   @map("author_id") @db.Uuid
  content        String
  /// A quote post embeds another post (ADR 0017): SetNull once the original is gone, `was_quote`
  /// keeps the frame ("This post is unavailable").
  quotedPostId   String?                  @map("quoted_post_id") @db.Uuid
  /// A badge the author shares on this post (ADR 0021, "Rewards"); held when posted.
  achievementKey String?                  @map("achievement_key")
  wasQuote       Boolean                  @default(false) @map("was_quote")
  /// Plain reposts plus quotes of this post; kept in step by PostsService and AccountService.
  repostCount    Int                      @default(0) @map("repost_count")
  /// Null until the first edit; previous texts live in post_revisions.
  editedAt       DateTime?                @map("edited_at") @db.Timestamptz(3)
  /// Generated by Postgres from `content` (migration `post_search`, ADR 0014). The `dbgenerated`
  /// default is how Prisma introspects a generated column; it only keeps the drift check quiet.
  /// Queried with raw SQL in `PostsService.search`.
  searchVector   Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, content)")) @map("search_vector")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments      Comment[]
  likes         PostLike[]
  activities    Activity[]
  revisions     PostRevision[]
  mentions      PostMention[]
  hashtags      PostHashtag[]
  notifications Notification[]
  bookmarks     Bookmark[]
  quotedPost    Post?          @relation("PostQuotes", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotes        Post[]         @relation("PostQuotes")
  reposts       Repost[]
  poll          Poll?
  pinnedBy      User?          @relation("PinnedPost")
  /// Messages that send this post to a chat (ADR 0009 amendment 4).
  sharedIn      Message[]      @relation("MessageSharedPost")
  images        PostImage[]

  @@index([quotedPostId])
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([searchVector], type: Gin)
  @@map("posts")
}

/// The pictures of a post (D2), in the order the author attached them, at most four. The upload
/// row carries the size; it only goes when nothing references the key any more, or with the
/// account, hence the cascade (whichever of the two cascades of an erased account runs first).
model PostImage {
  postId   String @map("post_id") @db.Uuid
  position Int    @db.SmallInt
  key      String

  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [key], references: [key], onDelete: Cascade)

  @@id([postId, position])
  @@index([key])
  @@map("post_images")
}

/// A post's poll (F3): two to four options, open until `closes_at`, fixed once posted (only
/// the post's text can change). `ended_notified_at` is stamped by the frequent job that tells
/// the author and the voters, so each poll ends once.
model Poll {
  postId          String    @id @map("post_id") @db.Uuid
  closesAt        DateTime  @map("closes_at") @db.Timestamptz(3)
  endedNotifiedAt DateTime? @map("ended_notified_at") @db.Timestamptz(3)

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  /// The frequent job's lookup: closed polls nobody has been told about yet.
  @@index([endedNotifiedAt, closesAt])
  @@map("polls")
}

model PollOption {
  id       String @id @default(uuid(7)) @db.Uuid
  postId   String @map("post_id") @db.Uuid
  position Int    @db.SmallInt
  text     String

  poll  Poll       @relation(fields: [postId], references: [postId], onDelete: Cascade)
  votes PollVote[]

  @@unique([postId, position])
  @@map("poll_options")
}

/// One vote per member and poll, final (decision P3).
model PollVote {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  poll   Poll       @relation(fields: [postId], references: [postId], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([optionId])
  @@index([userId])
  @@map("poll_votes")
}

/// Members a post's text mentions (`@username`), resolved by the API when the post is saved or
/// edited and replaced as a whole on every edit. Stored by id so renames keep the link.
model PostMention {
  postId String @map("post_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_mentions")
}

/// Lower-cased tags of a post. `created_at` copies the post's so a tag page can keyset-paginate
/// without a join.
model PostHashtag {
  tag       String
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([tag, postId])
  @@index([tag, createdAt(sort: Desc), postId(sort: Desc)])
  @@index([createdAt])
  /// A post's tags (replaced on edit) and a member's distinct tags (achievements, F2).
  @@index([postId])
  @@map("post_hashtags")
}

/// The text a post had before an edit replaced it (newest replacement first when listed).
model PostRevision {
  id       String   @id @default(uuid(7)) @db.Uuid
  postId   String   @map("post_id") @db.Uuid
  content  String
  editedAt DateTime @default(now()) @map("edited_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, editedAt(sort: Desc)])
  @@map("post_revisions")
}

model PostLike {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

/// A plain repost (ADR 0017): a pointer that puts someone else's post into the reposter's
/// followers' feeds at the time of the repost. One per member and post; a quote is a Post instead.
model Repost {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([postId])
  @@map("reposts")
}

/// A member's private "save for later" (C3a): no count on the post, no event, nobody else sees it.
model Bookmark {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt(sort: Desc), postId(sort: Desc)])
  @@map("bookmarks")
}

model Comment {
  id             String    @id @default(uuid(7)) @db.Uuid
  postId         String    @map("post_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  /// Set on a reply: the top-level comment it sits under (one level only, C2); replies go with it.
  parentId       String?   @map("parent_id") @db.Uuid
  content        String
  /// Null until the first edit; previous texts live in comment_revisions.
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)
  /// Denormalised total of comment_reactions, kept in step by CommentsService (sorting by "top").
  reactionsCount Int       @default(0) @map("reactions_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  post          Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]         @relation("CommentReplies")
  activities    Activity[]
  revisions     CommentRevision[]
  reactions     CommentReaction[]
  mentions      CommentMention[]
  notifications Notification[]

  @@index([postId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([postId, reactionsCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  /// Counting a member's comments (achievements, F2), the export and the erasure.
  @@index([authorId])
  @@index([parentId, createdAt, id])
  @@map("comments")
}

/// Members a comment's text mentions; same rules as `PostMention`.
model CommentMention {
  commentId String @map("comment_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_mentions")
}

model CommentRevision {
  id        String   @id @default(uuid(7)) @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  content   String
  editedAt  DateTime @default(now()) @map("edited_at") @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId, editedAt(sort: Desc)])
  @@map("comment_revisions")
}

enum ReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD

  @@map("reaction_type")
}

/// One reaction per member and comment; changing the emoji updates the row.
model CommentReaction {
  commentId String       @map("comment_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@index([commentId, type])
  @@map("comment_reactions")
}

enum UploadKind {
  avatar
  cover
  post
  message
  group
  voice

  @@map("upload_kind")
}

/// Every stored file and who uploaded it. Only the owner may attach a key to
/// their profile or posts; files are deleted when nothing references them.
model Upload {
  key       String     @id
  ownerId   String     @map("owner_id") @db.Uuid
  kind      UploadKind
  /// Of the stored file (D2); null for files stored before, until the daily job read them, and
  /// always null for a voice message, which has a duration instead.
  width      Int?
  height     Int?
  bytes      Int?
  /// Of a voice message, read from the file at upload (ADR 0009 amendment "voice messages").
  durationMs Int?       @map("duration_ms")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  postImages    PostImage[]
  messages      Message[]      @relation("MessageImage")
  voiceMessages Message[]      @relation("MessageVoice")
  conversations Conversation[]

  @@index([ownerId])
  @@index([createdAt])
  @@map("uploads")
}

/// follower_id <> followee_id is enforced by a CHECK constraint added by hand
/// in the initial migration (Prisma has no schema syntax for it) and in the service.
model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  follower User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FollowFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId, createdAt(sort: Desc), followerId(sort: Desc)])
  @@index([followerId, createdAt(sort: Desc), followeeId(sort: Desc)])
  @@map("follows")
}

enum ActivityType {
  POST_CREATED
  COMMENT_CREATED
  POST_LIKED
  USER_FOLLOWED
  PROFILE_UPDATED
  USER_REGISTERED
  POST_REPOSTED
  POST_QUOTED

  @@map("activity_type")
}

/// Written by the API in response to domain events, never by clients.
/// Subject columns are nullable because each type uses a different one.
model Activity {
  id           String       @id @default(uuid(7)) @db.Uuid
  actorId      String       @map("actor_id") @db.Uuid
  type         ActivityType
  postId       String?      @map("post_id") @db.Uuid
  commentId    String?      @map("comment_id") @db.Uuid
  targetUserId String?      @map("target_user_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  actor      User     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  targetUser User?    @relation("ActivityTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("activities")
}

enum NotificationType {
  POST_LIKED
  POST_COMMENTED
  COMMENT_REPLIED
  COMMENT_REACTED
  USER_FOLLOWED
  MENTIONED_IN_POST
  MENTIONED_IN_COMMENT
  POST_REPOSTED
  POST_QUOTED
  INVITE_JOINED
  ACHIEVEMENT_EARNED
  POLL_ENDED

  @@map("notification_type")
}

/// What happened to a member's own things (ADR 0015). Written by NotificationsListener from
/// domain events, never by clients; one row per (recipient, type, actor, post, comment), so a
/// repeated event refreshes the row instead of adding one. `post_id` is set for every type
/// but a follow, so the unique key has no nulls to worry about there. An earned badge (F2) has
/// no actor and names the badge in `achievement_key` instead; a badge is earned once.
model Notification {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType
  actorId        String?          @map("actor_id") @db.Uuid
  achievementKey String?          @map("achievement_key")
  postId         String?          @map("post_id") @db.Uuid
  commentId      String?          @map("comment_id") @db.Uuid
  readAt         DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, type, actorId, postId, commentId])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent")
  ip         String?
  /// When the session started: carried along the rotation chain (a rotated token is a new row).
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The last rotation (or the issue); the sessions list shows it as "last active".
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// The sign-in this token descends from: new at sign-in, carried along the rotation chain,
  /// and the access token's `sid` (ADR 0022: a device's push subscription ends with it).
  signInId   String    @default(uuid(7)) @map("sign_in_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([signInId])
  @@map("refresh_tokens")
}

/// A badge a member earned (F2, ADR 0021). Keys come from the shared `ACHIEVEMENTS` list, so a
/// new badge needs no migration; earned is earned, nothing ever removes a row but the erasure.
model UserAchievement {
  userId   String   @map("user_id") @db.Uuid
  key      String
  earnedAt DateTime @default(now()) @map("earned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([key])
  @@map("user_achievements")
}

/// A browser that receives web push for a member (ADR 0022): one row per push endpoint, tied to
/// the sign-in it was made under and deleted when that sign-in ends.
model PushSubscription {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  signInId   String   @map("sign_in_id") @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The last time the app handed it over (every start of a signed-in tab).
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([signInId])
  @@map("push_subscriptions")
}

enum ConversationKind {
  direct
  group

  @@map("conversation_kind")
}

enum ConversationRole {
  admin
  member

  @@map("conversation_role")
}

enum MessageKind {
  user
  system

  @@map("message_kind")
}

/// A direct conversation is the single thread between two people; a group has a title and members.
model Conversation {
  id            String           @id @default(uuid(7)) @db.Uuid
  kind          ConversationKind
  title         String?
  createdById   String?          @map("created_by_id") @db.Uuid
  /// `<smaller user id>:<larger user id>` for direct conversations, so a pair has exactly one.
  directKey     String?          @unique @map("direct_key")
  /// A group's picture (an upload of kind `group`, ADR 0009 amendment "group pictures"); null
  /// again when the upload leaves with its owner's account.
  pictureKey    String?          @map("picture_key")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Denormalised from the newest message so the list can be ordered without a join.
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz(3)

  createdBy User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  picture   Upload?              @relation(fields: [pictureKey], references: [key], onDelete: SetNull)
  members   ConversationMember[]
  messages  Message[]

  @@index([lastMessageAt, createdAt])
  @@index([pictureKey])
  @@map("conversations")
}

/// Read state is per member: everything created up to `lastReadAt` has been seen.
model ConversationMember {
  conversationId String           @map("conversation_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  /// Group admins rename, remove members and hand the role on; the creator starts as one.
  role           ConversationRole @default(member)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  lastReadAt     DateTime?        @map("last_read_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(uuid(7)) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  /// For a system line: who caused it.
  senderId       String      @map("sender_id") @db.Uuid
  /// `system` lines are written by the server about membership changes and renames.
  kind           MessageKind @default(user)
  /// Empty when the message is a picture, a post or a voice message only, a system line or deleted.
  content        String
  imageKey       String?     @map("image_key")
  /// A voice message (an upload of kind `voice`), alone in the message; null once deleted.
  voiceKey       String?     @map("voice_key")
  /// The waveform the recorder measured, 0..1 per slice; empty on every other message.
  voicePeaks     Float[]     @default([]) @map("voice_peaks")
  /// Null until the sender edited the text; previous texts live in message_revisions.
  editedAt       DateTime?   @map("edited_at") @db.Timestamptz(3)
  /// Soft delete by the sender: the row stays for ordering and read marks, content and picture go.
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)
  /// The subject of a system line (shared `systemLineSchema`).
  systemMeta     Json?       @map("system_meta") @db.JsonB
  /// A post sent to the chat (ADR 0009 amendment 4); null again once the post is deleted.
  sharedPostId   String?     @map("shared_post_id") @db.Uuid
  /// Stays true when the shared post is gone, so the bubble keeps an "unavailable" frame.
  sharesPost     Boolean     @default(false) @map("shares_post")
  /// The message this one answers, in the same conversation; null again if that row is erased.
  replyToId      String?     @map("reply_to_id") @db.Uuid
  /// Stays true when the original is erased with its sender's account: the quote becomes a frame.
  isReply        Boolean     @default(false) @map("is_reply")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  revisions    MessageRevision[]
  reactions    MessageReaction[]
  image        Upload?           @relation("MessageImage", fields: [imageKey], references: [key], onDelete: SetNull)
  voice        Upload?           @relation("MessageVoice", fields: [voiceKey], references: [key], onDelete: SetNull)
  sharedPost   Post?             @relation("MessageSharedPost", fields: [sharedPostId], references: [id], onDelete: SetNull)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")

  @@index([conversationId, createdAt, id])
  @@index([senderId])
  @@index([imageKey])
  @@index([voiceKey])
  @@index([sharedPostId])
  @@index([replyToId])
  @@map("messages")
}

model MessageRevision {
  id        String   @id @default(uuid(7)) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  content   String
  editedAt  DateTime @default(now()) @map("edited_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, editedAt(sort: Desc)])
  @@map("message_revisions")
}

/// One reaction per member and message (ADR 0009 amendment 3); no counter, threads are not ranked by it.
model MessageReaction {
  messageId String       @map("message_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("message_reactions")
}
